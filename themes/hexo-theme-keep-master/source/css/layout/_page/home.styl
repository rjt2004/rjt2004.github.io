.home-content-container {
  background var(--background-color-1)

  if (hexo-config('home') && hexo-config('home.announcement')) {
    .website-announcement {
      keep-container(var(--home-post-hover-scale), 1rem, 1.8rem)
      display flex
      align-items center
      justify-content space-between
      margin-top -0.6rem

      +keep-tablet() {
        margin-top -0.4rem
      }


      +keep-mobile() {
        margin-top -0.2rem

        .announcement {
          font-size 0.9rem
        }

        .icon {
          font-size 1rem !important
        }
      }


      .announcement {
        width 100%
        padding 0 0.5rem
        color var(--text-color-3)

        p {
          width 100%
          overflow hidden
          white-space nowrap
          text-overflow ellipsis
        }
      }


      .icon {
        flex-shrink 0
        padding 0.2rem
        font-size 1.2rem

        &.left {
          color var(--keep-danger-color)
          font-size 1.5rem
          transform-origin left bottom
          animation shake 1s ease infinite
        }

        &.right {
          color var(--text-color-4)
          cursor pointer

          &:hover {
            color var(--text-color-3)
          }
        }
      }
    }
  }

  .home-post-list {

    .home-post-item {
      position relative
      overflow hidden

      keep-container(var(--home-post-hover-scale), 0, 2.8rem)

      .post-sticky-box {
        position absolute
        z-index $z-index-1
        display flex
        align-items center
        box-sizing border-box
        padding 0.1rem 0.4rem
        color var(--text-color-4)
        font-size 12px
        letter-spacing 1px
        background var(--background-color-3)
        border-radius 0.3rem
        transform scale(0.86)
        cursor default
        disable-user-select()

        &.card {
          top 0.8rem
          right 0.8rem
        }

        +keep-mobile() {
          padding 0
          background none
          transform rotate(45deg)

          .sticky-name {
            display none
          }
        }
      }


      .home-post-bg {
        position absolute
        top 0
        right 0
        bottom 0
        left auto
        width 38%
        background-image var(--home-cover-bg)
        background-position center
        background-size cover
        background-repeat no-repeat
        -webkit-mask-image linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.5) 38%, #000 68%)
        mask-image linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.5) 38%, #000 68%)
        transform-origin right center
        pointer-events none
        transition-t("transform", "0", "1", "linear")

        +keep-mobile() {
          width 42%
        }
      }

      &:hover .home-post-bg {
        transform scale(1.04)
      }


      .home-post-item-body {
        position relative
        z-index 1
        display flex
        align-items center
        padding 1.8rem 2rem

        +keep-tablet() {
          padding 1.5rem 1.6rem
        }

        +keep-mobile() {
          padding 1.2rem 1.3rem
        }
      }

      &.has-cover .home-post-item-body {
        min-height 9.6rem
        padding-right 27%

        +keep-mobile() {
          min-height 7.6rem
          padding-right 30%
        }
      }


      .home-post-item-info {
        min-width 0
        width 100%

        .home-post-title {
          margin 0
          font-weight 600
          font-size 1.4rem
          line-height 1.5

          a.home-post-link {
            color var(--text-color-2)

            &::after {
              position absolute
              top 0
              right 0
              bottom 0
              left 0
              z-index 2
              content ''
            }

            &:hover {
              color var(--primary-color)
            }
          }


          +keep-tablet() {
            font-size 1.3rem
          }


          +keep-mobile() {
            font-size 1.2rem
          }
        }


        .home-post-dates {
          display flex
          flex-wrap wrap
          gap 0.35rem 1.4rem
          margin-top 0.9rem
          color var(--text-color-4)
          font-size 0.92rem

          .meta-info-item {
            display flex
            align-items center

            i.icon {
              color var(--text-color-4)
              font-size 0.9rem
            }
          }

          +keep-mobile() {
            gap 0.3rem 1rem
            font-size 0.85rem
          }
        }
      }
    }
  }
  +keep-mobile() {
    .home-post-list {
      width 100%
    }

    .home-post-item {
      width 100%
      min-width 0
      margin-left 0
      margin-right 0
    }

    .home-post-item.has-cover .home-post-item-body {
      padding-right 1.3rem
    }

    .home-post-bg {
      width 40%
    }
  }
}
