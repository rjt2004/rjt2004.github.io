<div class="home-content-container fade-in-down-animation">
    <%
        const resolvePostAsset = (post, asset) => {
            if (!asset) return asset
            if (/^(https?:)?\/\//.test(asset) || asset.startsWith('/') || asset.startsWith('../') || asset.startsWith('./')) {
                return asset
            }
            return `${post.path}${asset}`
        }
        const post_created_icon = theme?.post?.created_datetime_icon || 'fa-solid fa-calendar-plus'
        const post_updated_icon = theme?.post?.updated_datetime_icon || 'fa-solid fa-file-pen'
        const post_datetime_format = theme?.post?.datetime_format || 'YYYY-MM-DD'
    %>
    <% if (theme?.home?.announcement) { %>
        <div class="website-announcement border-box">
            <i class="icon left fa-solid fa-bullhorn"></i>
            <div class="announcement border-box text-ellipsis">
                <%- markdown(theme?.home?.announcement) %>
            </div>
            <i class="icon right close fa-solid fa-close"></i>
        </div>
    <% } %>
    <ul class="home-post-list border-box">
        <% page.posts.forEach(post => { %>
            <li class="home-post-item<%= post?.home_cover ? ' has-cover' : '' %>" data-post-month="<%= date(post.date, 'YYYY-MM') %>">
                <% if (post?.home_cover) { %>
                    <% const home_cover = resolvePostAsset(post, post.home_cover) %>
                    <div class="home-post-bg" style="--home-cover-bg: url('<%- url_for(home_cover) %>')"></div>
                <% } %>
                <div class="home-post-item-body border-box">
                    <div class="home-post-item-info border-box">
                        <% if (post.sticky) { %>
                            <div class="post-sticky-box card">
                                <i class="fas fa-thumbtack"></i><span class="sticky-name">&nbsp;<%- __('top') %></span>
                            </div>
                        <% } %>
                        <h3 class="home-post-title border-box">
                            <a class="home-post-link" href="<%- url_for(post.path) %>"><%= post.title %></a>
                        </h3>
                        <div class="home-post-dates border-box">
                            <span class="meta-info-item post-create-date">
                                <i class="icon <%= post_created_icon %>"></i>&nbsp;<span class="datetime"><%= date(post.date, post_datetime_format) %></span>
                            </span>
                            <span class="meta-info-item post-update-date">
                                <i class="icon <%= post_updated_icon %>"></i>&nbsp;<span class="datetime" data-updated="<%= date(post.updated, 'YYYY-MM-DD') %>"><%= date(post.updated, post_datetime_format) %></span>
                            </span>
                        </div>
                    </div>
                </div>
            </li>
        <% }) %>
    </ul>
    <%- partial('_partial/paginator', { page_info: page }) %>
</div>